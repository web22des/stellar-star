---
import Logo from '../ui/Logo.astro';
import Link from '../ui/Link.astro';
import SocialContact from '../ui/SocialContact.astro';
---

<header class="header">
  <div class="header__container">
    <div class="header__logo-wrap">
      <Logo />
    </div>
    <div class="header__menu menu">
      <button type="button" class="menu__icon icon-menu"><span></span></button>
      <nav class="menu__body">
        <ul class="menu__list">
          <li>
            <button class="menu__link">Главная<span class="_icon-circle-down"></span></button>
            <ul class="menu__sub-list">
              <li class="menu__subitem"><Link href="/" class="menu__sublink">На главную</Link></li>
              <li class="menu__subitem"><Link href="#advantages" class="menu__sublink" data-goto="#advantages">Преимущества</Link></li>
              <li class="menu__subitem"><Link href="#services" class="menu__sublink" data-goto="#services">Услуги</Link></li>
              <li class="menu__subitem"><Link href="#website-types" class="menu__sublink" data-goto="#website-types">Виды сайтов</Link></li>
              <li class="menu__subitem"><Link href="#development-process" class="menu__sublink" data-goto="#development-process">Процесс разработки</Link></li>
              <li class="menu__subitem"><Link href="#result" class="menu__sublink" data-goto="#result">Результат</Link></li>
              <li class="menu__subitem"><Link href="#examples-work" class="menu__sublink" data-goto="#examples-work">Галерея</Link></li>
              <li class="menu__subitem"><Link href="#contact-form" class="menu__sublink" data-goto="#contact-form">Обратная связь</Link></li>
            </ul>
          </li>
          <li><a data-goto=".page__section--2" href="#" class="menu__link">Курсы</a></li>
          <li><a data-goto=".page__section--2" href="#" class="menu__link">Сериалы</a></li>
          <li>
            <button class="menu__link">Новости<span class="_icon-circle-down"></span></button>
            <ul class="menu__sub-list">
              <li class="menu__subitem"><Link href="/news/" class="menu__sublink">Новости IT</Link></li>
              <li class="menu__subitem"><Link href="/post/" class="menu__sublink">Блог</Link></li>
            </ul>
          </li>
          <li><a data-goto=".page__section--3" href="#" class="menu__link">Контакты</a></li>
        </ul>
      </nav>
    </div>
    <div class="header__social-wrap">
      <SocialContact />
    </div>
  </div>
</header>

<!-- =============== -->
<style lang="scss">
  //@use '@styles/base/media-new.scss' as media;

  body._lock {
    overflow: hidden;
  }

  /* ========================== */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 10;
    background-color: var(--md-sys-color-surface-variant);

    &__container {
      display: flex;
      padding-top: 8px;
      padding-bottom: 8px;
      align-items: center;
      justify-content: space-between;
      min-height: 70px;
      //767px и более
      @media (min-width: $tablet-small) {
        flex-wrap: wrap;
      }
    }

    &__social-wrap {
      display: none;
      //1023px и более
      @media (min-width: $tablet-medium) {
        display: block;
      }
    }
    &__logo-wrap {
      width: 180px;
    }

    // &__logo {
    //   width: 100px;
    //   height: auto;

    //   img {
    //     width: 100%;
    //   }
    // }

    // &__themetoggle-wrap {
    //   display: flex;
    //   justify-content: end;

    //   //767px и более
    //   @media (min-width: $tablet-small) {
    //     width: 100%;
    //     justify-content: center;
    //   }
    // }
  }

  /* Меню (Mobile First) */
  .menu {
    &__icon {
      display: block; // Показываем бургер-меню по умолчанию (mobile)
      z-index: 5;
      position: relative;
      width: 30px;
      height: 18px;
      cursor: pointer;

      span,
      &::before,
      &::after {
        left: 0;
        position: absolute;
        height: 10%;
        width: 100%;
        transition: all 0.3s ease 0s;
        background-color: var(--md-sys-color-on-surface);
      }

      &::before,
      &::after {
        content: '';
      }

      &::before {
        top: 0;
      }

      &::after {
        bottom: 0;
      }

      span {
        top: 50%;
        transform: scale(1) translate(0px, -50%);
      }

      &._active {
        span {
          transform: scale(0) translate(0px, -50%);
        }

        &::before {
          top: 50%;
          transform: rotate(-45deg) translate(0px, -50%);
        }

        &::after {
          bottom: 50%;
          transform: rotate(45deg) translate(0px, 50%);
        }
      }
    }

    &__body {
      position: fixed;
      top: 0;
      left: -100%;
      max-width: 320px;
      width: 100%;
      height: 100%;
      background-color: var(--md-sys-color-secondary);
      padding: 100px 30px 30px 30px;
      transition: left 0.3s ease 0s;
      overflow: auto;
      z-index: 1;

      &._active {
        // Выезд меню слева
        left: 0;
      }

      &::before {
        content: '';
        position: fixed;
        width: 100%;
        top: 0;
        left: 0;
        height: 70px;
        z-index: 2;
        //background-color: tomato;
      }
      //1023px и более
      @media (min-width: $tablet-medium) {
        max-width: 100%;
      }
    }

    &__list {
      li {
        flex-wrap: wrap;
        margin: 0px 0px 30px 0px;

        &:last-child {
          margin-bottom: 0;
        }

        &._active .menu__sub-list {
          display: block;
        }
      }
    }

    &__link {
      font-size: 24px;
      color: var(--md-sys-color-on-surface);
      display: flex;
      gap: 4px;
      align-items: center;
      &:hover {
        text-decoration: underline;
      }
    }

    &__sub-list {
      position: relative;
      background-color: #fff;
      flex: 1 1 100%;
      margin: 20px 0px 0px 0px;
      padding: 12px;
      display: none;
    }

    &__sublink {
      font-size: 20px;
      color: tomato;

      &:hover {
        text-decoration: underline;
      }
    }

    &__arrow {
      //display: none;
    }

    //1023px и более
    @media (min-width: $tablet-medium) {
      &__icon {
        display: none; // Скрываем бургер на планшетах и выше
      }

      &__body {
        position: static;
        width: auto;
        height: auto;
        background-color: transparent;
        padding: 0;
        overflow: visible;

        &::before {
          display: none;
        }
      }

      &__list {
        display: flex;
        align-items: center;

        > li {
          position: relative;
          margin: 0px 0px 0px 20px;
          padding: 10px 0;
          flex-wrap: nowrap;
        }
      }

      &__link {
        font-size: 18px;
      }

      &__sub-list {
        box-shadow: var(--box-shadow-Light-01);
        position: absolute;
        top: 20px;
        right: 0;
        background-color: var(--md-sys-color-primary);
        padding: 15px;
        min-width: 200px;
        min-width: max-content;
        transform: translate(0px, 10%);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: all 0.7s ease 0s;
        display: block !important; // Переопределяем mobile-стили

        li {
          margin: 0px 0px 10px 0px;

          &:last-child {
            margin: 0px;
          }
        }
      }

      &__sublink {
        //color: tomato;
      }
    }

    ._icon-circle-down {
      //display: none;
      font-size: 14px;
    }
  }

  /* Поведение для PC и Touch устройств */
  html.no-touch .menu__list > li:hover .menu__sub-list {
    opacity: 1;
    visibility: visible;
    transform: translate(0px, 0px);
    pointer-events: all;
  }

  html.touch {
    //1023px и более
    @media (min-width: $tablet-medium) {
      .menu__list > li {
        display: flex;
        align-items: center;
      }

      .menu__link {
        flex: 1 1 auto;
      }
      ._icon-circle-down {
        //display: block !important;
      }
      // .menu__arrow {
      //   display: block;
      //   width: 0;
      //   height: 0;
      //   margin: 0px 0px 0px 5px;
      //   transition: transform 0.3s ease 0s;
      //   border-left: 5px solid transparent;
      //   border-right: 5px solid transparent;
      //   border-top: 10px solid #fff;
      // }

      .menu__list > li._active {
        .menu__sub-list {
          opacity: 1;
          visibility: visible;
          transform: translate(0px, 0px);
          pointer-events: all;
        }

        // .menu__arrow {
        //   transform: rotate(-180deg);
        // }
        ._icon-circle-down {
          transform: rotate(-180deg);
        }
      }
    }
  }
</style>

<script>
  // Общие элементы
  const iconMenu = document.querySelector('.menu__icon');
  const menuBody = document.querySelector('.menu__body');

  // 1. Инициализация бургер-меню
  if (iconMenu && menuBody) {
    iconMenu.addEventListener('click', function (e) {
      document.body.classList.toggle('_lock');
      iconMenu.classList.toggle('_active');
      menuBody.classList.toggle('_active');
    });
  }

  // 2. Обработчик для плавной прокрутки
  //const menuLinks = document.querySelectorAll('.menu__link[data-goto]');
  const menuLinks = document.querySelectorAll('.menu__sublink[data-goto]');
  if (menuLinks.length > 0) {
    menuLinks.forEach((menuLink) => {
      menuLink.addEventListener('click', function (e) {
        if (this.dataset.goto && document.querySelector(this.dataset.goto)) {
          const gotoBlock = document.querySelector(this.dataset.goto);
          const gotoBlockValue = gotoBlock.getBoundingClientRect().top + scrollY - document.querySelector('header').offsetHeight;

          // Закрываем меню если открыто (бургер)
          if (iconMenu && iconMenu.classList.contains('_active')) {
            document.body.classList.remove('_lock');
            iconMenu.classList.remove('_active');
            menuBody.classList.remove('_active');
          }

          window.scrollTo({
            top: gotoBlockValue,
            behavior: 'smooth',
          });
          e.preventDefault();
        }
      });
    });
  }

  // 3. Обработчик подменю
  const menuItemsWithSub = document.querySelectorAll('.menu__list > li:has(.menu__sub-list)');
  if (menuItemsWithSub.length > 0) {
    menuItemsWithSub.forEach((item) => {
      const button = item.querySelector('.menu__link');

      if (button) {
        button.addEventListener('click', function (e) {
          // Работаем только для touch-устройств
          if (document.documentElement.classList.contains('touch')) {
            e.preventDefault();
            e.stopPropagation();

            if (item.classList.contains('_active')) {
              item.classList.remove('_active');
            } else {
              // Закрываем другие открытые подменю
              document.querySelectorAll('.menu__list > li._active').forEach((activeItem) => {
                if (activeItem !== item) activeItem.classList.remove('_active');
              });
              item.classList.add('_active');
            }
          }
        });
      }
    });

    // Закрытие подменю при клике вне области
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.menu__list > li')) {
        document.querySelectorAll('.menu__list > li._active').forEach((item) => {
          item.classList.remove('_active');
        });
      }
    });
  }
</script>
