---
import PageLayout from '../layouts/PageLayout.astro';

const title = 'Цветовая палитра Matherial Theme 3';
---

<PageLayout title={title}>
  <div class="colors">
    <div class="colors__container">
      <h1 class="colors__title">{title}</h1>
      <div class="colors__wrapper">
        <ul class="colors__list">
          <span>Surface</span>
          <li class="colors__item colors__on-surface">
            <code> background-color: var(--md-sys-color-on-surface);</code>
            <code> color: var(--md-sys-color-surface);</code>
          </li>
          <li class="colors__item colors__surface">
            <code> background-color: var(--md-sys-color-surface);</code>
            <code> color: var(--md-sys-color-on-surface);</code>
          </li>
          <li class="colors__item colors__surface-variant">
            <code> background-color: var(--md-sys-color-surface-variant);</code>
            <code> color: var(--md-sys-color-on-surface-variant);</code>
          </li>
          <li class="colors__item colors__surface-tint">
            <code> background-color: var(--md-sys-color-surface-tint);</code>
            <code> color: var(--md-sys-color-surface);</code>
          </li>

          <li class="colors__item colors__surface-dim">
            <code> background-color: var(--md-sys-color-surface-dim);</code>
            <code> color: var(--md-sys-color-on-surface);</code>
          </li>

          <li class="colors__item colors__surface-bright">
            <code> background-color: var(--md-sys-color-surface-bright);</code>
            <code> color: var(--md-sys-color-on-surface);</code>
          </li>
          <li class="colors__item colors__surface-container-lowest">
            <code> background-color: var(--md-sys-color-surface-container-lowest);</code>
            <code> color: var(--md-sys-color-on-surface);</code>
          </li>
          <li class="colors__item colors__surface-container-low">
            <code> background-color: var(--md-sys-color-surface-container-low);</code>
            <code> background-color: var(--md-sys-color-on-surface);</code>
          </li>
          <li class="colors__item colors__surface-container">
            <code> background-color: var(--md-sys-color-surface-container);</code>
            <code> background-color: var(--md-sys-color-on-surface);</code>
          </li>
          <li class="colors__item colors__surface-container-high">
            <code> background-color: var(--md-sys-color-surface-container-high);</code>
            <code> background-color: var(--md-sys-color-on-surface);</code>
          </li>
          <li class="colors__item colors__surface-container-highest">
            <code> background-color: var(--md-sys-color-surface-container-highest);</code>
            <code> background-color: var(--md-sys-color-on-surface);</code>
          </li>
          <li class="colors__item colors__inverse-surface">
            <code> background-color: var(--md-sys-color-inverse-surface);</code>
            <code> color: var(--md-sys-color-inverse-on-surface);</code>
          </li>
          <li class="colors__item colors__inverse-on-surface">
            <code> background-color: var(--md-sys-color-inverse-on-surface);</code>
            <code> color: var(--md-sys-color-inverse-surface);</code>
          </li>
        </ul>

        <ul class="colors__list">
          <span>Primary</span>
          <li class="colors__item colors__on-primary">
            <code> background-color: var(--md-sys-color-on-primary);</code>
            <code> color: var(--md-sys-color-primary);</code>
          </li>
          <li class="colors__item colors__primary-container">
            <code> background-color: var(--md-sys-color-primary-container);</code>
            <code> color: var(--md-sys-color-on-primary-container);</code>
          </li>
          <li class="colors__item colors__inverse-primary">
            <code> background-color: var(--md-sys-color-inverse-primary);</code>
          </li>

          <li class="colors__item colors__primary">
            <code> background-color: var(--md-sys-color-primary);</code>
            <code> color: var(--md-sys-color-on-primary);</code>
          </li>

          <li class="colors__item colors__on-primary-container">
            <code> color: var(--md-sys-color-primary-container);</code>
            <code> background-color: var(--md-sys-color-primary-on-container);</code>
          </li>
          <li class="colors__item colors__primary-fixed">
            <code> background-color: var(--md-sys-color-primary-fixed);</code>
          </li>
          <li class="colors__item colors__primary-fixed-dim">
            <code> background-color: var(--md-sys-color-primary-fixed-dim);</code>
          </li>
          <li class="colors__item colors__on-primary-fixed-variant">
            <code> background-color: var(--md-sys-color-on-primary-fixed-variant);</code>
          </li>
          <li class="colors__item colors__on-primary-fixed">
            <code> background-color: var(--md-sys-color-on-primary-fixed);</code>
          </li>
        </ul>
        <!-- Secondary -->
        <ul class="colors__list">
          <span>Secondary</span>
          <li class="colors__item colors__secondary">
            <code> background-color: var(--md-sys-color-secondary);</code>
            <code> color: var(--md-sys-color-on-secondary);</code>
          </li>
          <li class="colors__item colors__on-secondary">
            <code> background-color: var(--md-sys-color-on-secondary);</code>
            <code> color: var(--md-sys-color-secondary);</code>
          </li>
          <li class="colors__item colors__secondary-container">
            <code> background-color: var(--md-sys-color-secondary-container);</code>
            <code> color: var(--md-sys-color-on-secondary-container);</code>
          </li>
          <li class="colors__item colors__on-secondary-container">
            <code> background-color: var(--md-sys-color-on-secondary-container);</code>
            <code> color: var(--md-sys-color-secondary-container);</code>
          </li>
          <li class="colors__item colors__secondary-fixed">
            <code> background-color: var(--md-sys-color-secondary-fixed);</code>
            <code> color: var(--md-sys-color-on-secondary-fixed);</code>
          </li>
          <li class="colors__item colors__on-secondary-fixed">
            <code> background-color: var(--md-sys-color-on-secondary-fixed);</code>
            <code> color: var(--md-sys-color-secondary-fixed);</code>
          </li>
          <li class="colors__item colors__secondary-fixed-dim">
            <code> background-color: var(--md-sys-color-secondary-fixed-dim);</code>
            <code> color: var(--md-sys-color-on-secondary-fixed);</code>
          </li>
          <li class="colors__item colors__on-secondary-fixed-variant">
            <code> background-color: var(--md-sys-color-on-secondary-fixed-variant);</code>
            <code> color: var(--md-sys-color-secondary-fixed);</code>
          </li>
        </ul>

        <ul class="colors__list">
          <span>Tertiary</span>
          <li class="colors__item colors__tertiary">
            <code> background-color: var(--md-sys-color-tertiary);</code>
            <code> color: var(--md-sys-color-on-tertiary);</code>
          </li>
          <li class="colors__item colors__on-tertiary">
            <code> background-color: var(--md-sys-color-on-tertiary);</code>
            <code> color: var(--md-sys-color-tertiary);</code>
          </li>
          <li class="colors__item colors__tertiary-container">
            <code> background-color: var(--md-sys-color-tertiary-container);</code>
            <code> color: var(--md-sys-color-on-tertiary-container);</code>
          </li>
          <li class="colors__item colors__on-tertiary-container">
            <code> background-color: var(--md-sys-color-on-tertiary-container);</code>
            <code> color: var(--md-sys-color-tertiary-container);</code>
          </li>
          <li class="colors__item colors__tertiary-fixed">
            <code> background-color: var(--md-sys-color-tertiary-fixed);</code>
            <code> color: var(--md-sys-color-on-tertiary-fixed);</code>
          </li>
          <li class="colors__item colors__on-tertiary-fixed">
            <code> background-color: var(--md-sys-color-on-tertiary-fixed);</code>
            <code> color: var(--md-sys-color-tertiary-fixed);</code>
          </li>
          <li class="colors__item colors__tertiary-fixed-dim">
            <code> background-color: var(--md-sys-color-tertiary-fixed-dim);</code>
            <code> color: var(--md-sys-color-on-tertiary-fixed);</code>
          </li>
          <li class="colors__item colors__on-tertiary-fixed-variant">
            <code> background-color: var(--md-sys-color-on-tertiary-fixed-variant);</code>
            <code> color: var(--md-sys-color-tertiary-fixed);</code>
          </li>
        </ul>

        <ul class="colors__list">
          <span>Error</span>
          <li class="colors__item colors__error">
            <code> background-color: var(--md-sys-color-error);</code>
            <code> color: var(--md-sys-color-on-error);</code>
          </li>
          <li class="colors__item colors__on-error">
            <code> background-color: var(--md-sys-color-on-error);</code>
            <code> color: var(--md-sys-color-);</code>
          </li>
          <li class="colors__item colors__error-container">
            <code> background-color: var(--md-sys-color-error-container);</code>
            <code> color: var(--md-sys-color-on-error-container);</code>
          </li>
          <li class="colors__item colors__on-error-container">
            <code> background-color: var(--md-sys-color-on-error-container);</code>
            <code> color: var(--md-sys-color-error-container);</code>
          </li>
        </ul>

        <ul class="colors__list">
          <span>Background</span>
          <li class="colors__item colors__background">
            <code> background-color: var(--md-sys-color-background);</code>
            <code> color: var(--md-sys-color-on-background);</code>
          </li>
          <li class="colors__item colors__on-background">
            <code> background-color: var(--md-sys-color-on-background);</code>
            <code> color: var(--md-sys-color-background);</code>
          </li>
        </ul>

        <ul class="colors__list">
          <span>Outline</span>
          <li class="colors__item colors__outline">
            <code> background-color: var(--md-sys-color-outline);</code>
            <code> color: var(--md-sys-color-);</code>
          </li>
          <li class="colors__item colors__outline-variant">
            <code> background-color: var(--md-sys-color-outline-variant);</code>
            <code> color: var(--md-sys-color-);</code>
          </li>
        </ul>
      </div>
    </div>
  </div>
</PageLayout>

<style lang="scss">
  .colors {
    margin-top: 150px;
    &__container {
    }
    &__title {
      font-size: 32px;
      margin-bottom: 24px;
      text-align: center;
      color: var(--md-sys-color-on-surface);
    }
    &__wrapper {
    }

    &__list {
      margin-top: 28px;
      span {
        color: var(--md-sys-color-primary);
        font-size: 24px;
      }
    }

    &__item {
      padding: 24px;
      border: 1px solid #000;
      margin-bottom: 12px;

      code {
        display: block;
      }
    }
    &__primary {
      background-color: var(--md-sys-color-primary);
      color: var(--md-sys-color-on-primary);
    }
    &__on-primary {
      background-color: var(--md-sys-color-on-primary);
      color: var(--md-sys-color-primary);
    }
    &__primary-container {
      background-color: var(--md-sys-color-primary-container);
      color: var(--md-sys-color-on-primary-container);
    }
    &__on-primary-container {
      background-color: var(--md-sys-color-on-primary-container);
      color: var(--md-sys-color-primary-container);
    }
    &__inverse-primary {
      background-color: var(--md-sys-color-inverse-primary);
    }
    &__primary-fixed {
      background-color: var(--md-sys-color-primary-fixed);
      color: var(--md-sys-color-on-primary-fixed);
    }
    &__on-primary-fixed {
      background-color: var(--md-sys-color-on-primary-fixed);
      color: var(--md-sys-color-primary-fixed);
    }
    &__primary-fixed-dim {
      background-color: var(--md-sys-color-primary-fixed-dim);
      color: var(--color-primary);
    }
    &__on-primary-fixed-variant {
      background-color: var(--md-sys-color-on-primary-fixed-variant);
      color: var(--md-sys-color-primary-fixed);
    }

    &__inverse-surface {
      background-color: var(--md-sys-color-inverse-surface);
      color: var(--md-sys-color-inverse-on-surface);
    }
    &__inverse-on-surface {
      background-color: var(--md-sys-color-inverse-on-surface);
      color: var(--md-sys-color-inverse-surface);
    }
    &__surface {
      background-color: var(--md-sys-color-surface);
      color: var(--md-sys-color-on-surface);
    }
    &__on-surface {
      background-color: var(--md-sys-color-on-surface);
      color: var(--md-sys-color-surface);
    }
    &__surface-variant {
      background-color: var(--md-sys-color-surface-variant);
      color: var(--md-sys-color-on-surface-variant);
    }
    &__on-surface-variant {
      background-color: var(--md-sys-color-on-surface-variant);
      color: var(--md-sys-color-surface-variant);
    }
    &__surface-tint {
      background-color: var(--md-sys-color-surface-tint);
      color: var(--md-sys-color-surface);
    }
    &__surface-dim {
      background-color: var(--md-sys-color-surface-dim);
      color: var(--md-sys-color-on-surface);
    }
    &__surface-bright {
      background-color: var(--md-sys-color-surface-bright);
      color: var(--md-sys-color-on-surface);
    }
    &__surface-container-lowest {
      background-color: var(--md-sys-color-surface-container-lowest);
      color: var(--md-sys-color-on-surface);
    }
    &__surface-container-low {
      background-color: var(--md-sys-color-surface-container-low);
      color: var(--md-sys-color-on-surface);
    }
    &__surface-container {
      background-color: var(--md-sys-color-surface-container);
      color: var(--md-sys-color-on-surface);
    }
    &__surface-container-high {
      background-color: var(--md-sys-color-surface-container-high);
      color: var(--md-sys-color-on-surface);
    }
    &__surface-container-highest {
      background-color: var(--md-sys-color-surface-container-highest);
      color: var(--md-sys-color-on-surface);
    }

    &__secondary {
      background-color: var(--md-sys-color-secondary);
      color: var(--md-sys-color-on-secondary);
    }
    &__on-secondary {
      background-color: var(--md-sys-color-on-secondary);
      color: var(--md-sys-color-secondary);
    }
    &__secondary-container {
      background-color: var(--md-sys-color-secondary-container);
      color: var(--md-sys-color-on-secondary-container);
    }
    &__on-secondary-container {
      background-color: var(--md-sys-color-on-secondary-container);
      color: var(--md-sys-color-secondary-container);
    }
    &__secondary-fixed {
      background-color: var(--md-sys-color-secondary-fixed);
      color: var(--md-sys-color-on-secondary-fixed);
    }
    &__on-secondary-fixed {
      background-color: var(--md-sys-color-on-secondary-fixed);
      color: var(--md-sys-color-secondary-fixed);
    }
    &__secondary-fixed-dim {
      background-color: var(--md-sys-color-secondary-fixed-dim);
      color: var(--md-sys-color-on-secondary-fixed);
    }
    &__on-secondary-fixed-variant {
      background-color: var(--md-sys-color-on-secondary-fixed-variant);
      color: var(--md-sys-color-secondary-fixed);
    }

    &__tertiary {
      background-color: var(--md-sys-color-tertiary);
      color: var(--md-sys-color-on-tertiary);
    }
    &__on-tertiary {
      background-color: var(--md-sys-color-on-tertiary);
      color: var(--md-sys-color-tertiary);
    }
    &__tertiary-container {
      background-color: var(--md-sys-color-tertiary-container);
      color: var(--md-sys-color-on-tertiary-container);
    }
    &__on-tertiary-container {
      background-color: var(--md-sys-color-on-tertiary-container);
      color: var(--md-sys-color-tertiary-container);
    }
    &__tertiary-fixed {
      background-color: var(--md-sys-color-tertiary-fixed);
      color: var(--md-sys-color-on-tertiary-fixed);
    }
    &__on-tertiary-fixed {
      background-color: var(--md-sys-color-on-tertiary-fixed);
      color: var(--md-sys-color-tertiary-fixed);
    }
    &__tertiary-fixed-dim {
      background-color: var(--md-sys-color-tertiary-fixed-dim);
      color: var(--md-sys-color-on-tertiary-fixed);
    }
    &__on-tertiary-fixed-variant {
      background-color: var(--md-sys-color-on-tertiary-fixed-variant);
      color: var(--md-sys-color-tertiary-fixed);
    }

    &__error {
      background-color: var(--md-sys-color-error);
      color: var(--md-sys-color-on-error);
    }
    &__on-error {
      background-color: var(--md-sys-color-on-error);
