---
import PageLayout from '../layouts/PageLayout.astro';
import path from 'path';

const title = 'Посты';

// 1. Загружаем посты с базовой типизацией
const postFiles: Record<
  string,
  {
    frontmatter?: {
      title?: string;
      description?: string;
      date?: string;
      image?: string; // ← ДОБАВЛЯЕМ
      imageAlt?: string; // ← ДОБАВЛЯЕМ
    };
  }
> = import.meta.glob('./posts/*.md', { eager: true });

// 2. Преобразуем в массив постов
const allPosts = Object.entries(postFiles).map(([filePath, file]) => {
  return {
    slug: path.basename(filePath, '.md'),
    title: file.frontmatter?.title || 'Автор забыл указать название',
    description: file.frontmatter?.description || '',
    date: file.frontmatter?.date || new Date().toISOString(),
    image: file.frontmatter?.image || null, // ← ДОБАВЛЯЕМ
    imageAlt: file.frontmatter?.imageAlt || '', // ← ДОБАВЛЯЕМ
  };
});

// 3. Сортируем по дате
const sortedPosts = [...allPosts].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// 4. Формируем URL
const baseUrl = import.meta.env.BASE_URL || '/';
const getPostUrl = (slug: string) => `${baseUrl}posts/${slug}/`;
---

<PageLayout title={title}>
  <div class="my-posts">
    <div class="my-posts__container">
      <h1 class="my-posts__title">{title}</h1>
      <ul>
        {
          sortedPosts.map((post) => (
            <li>
              <a href={getPostUrl(post.slug)}>
                <img src={post.image} alt={post.imageAlt || post.title} width="400" height="225" loading="lazy" class="my-posts__image" />
                <h2>{post.title}</h2>
                {post.description && <p>{post.description}</p>}
                <small>{new Date(post.date).toLocaleDateString('ru-RU')}</small>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</PageLayout>

<style lang="scss">
  .my-posts {
    margin-top: 150px;
    &__container {
    }

    &__title {
      font-size: 32px;
      margin-bottom: var(--space-section);
      font-weight: var(--font-weight-bold);
      text-transform: uppercase;
    }

    &__image {
      border-radius: var(--border-radius-medium);
    }

    li {
      margin-bottom: var(--space-lg);
      box-shadow: var(--box-shadow-Light-01);
      border-radius: var(--border-radius-medium);
      padding: var(--space-all-card);
    }

    h2 {
      font-size: var(--font-size-headline-small);
    }
  }
</style>
