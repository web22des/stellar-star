---
import MenuSubList from '../components/ui/MenuSubList.astro';
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout>
  <div class="test">
    <div class="test__container">
      <MenuSubList />
      <div class="test__content">Далеко-далеко за словесными горами в стране гласных и согласных живут рыбные тексты. Обеспечивает даль алфавит власти то журчит встретил о всеми, которой вопроса прямо проектах мир текстов, города переулка последний от всех они если имеет? Послушавшись маленькая дал за, имеет толку бросил имени приставка несколько там маленький это вопроса запятых агентство свое переписывается свой скатился его ему страна. Приставка осталось, эта продолжил несколько о взгляд. Парадигматическая злых, заглавных она большого деревни текста, послушавшись бросил, семь маленький коварных собрал.</div>
    </div>
  </div>
</PageLayout>

<style lang="scss">
  .test {
    background: var(--md-sys-color-surface-container);
    &__container {
      padding-top: var(--space-md);
      padding-bottom: var(--space-md);
    }
    &__content {
      padding-top: var(--space-section);
      min-height: 100vh;
      background: var(--md-sys-color-primary-container);
    }
  }
</style>
