---
import { Image } from 'astro:assets';
import TitleSections from '../ui/TitleSection.astro';

const titleSection = 'Услуги, нацеленные на результат';
const subTitleSection = 'Обладая опытом  в своей области, я стремлюсь к эффективной и быстрой реализации проектов. Мой приоритет - это скорость выполнения без потери качества и внимания к деталям. Каждый проект будет выполнен с максимальной тщательностью и в срок.';

import services01 from '@assets/images/content/serviсes/serviсes-01.jpg';
import services02 from '@assets/images/content/serviсes/serviсes-02.jpg';
import services03 from '@assets/images/content/serviсes/serviсes-03.jpg';
import services04 from '@assets/images/content/serviсes/serviсes-04.jpg';
import services05 from '@assets/images/content/serviсes/serviсes-05.jpg';
import services06 from '@assets/images/content/serviсes/serviсes-06.jpg';
---

<div class="services animate">
  <div class="services__container">
    <TitleSections titleSection={titleSection} subTitleSection={subTitleSection} />
    <!-- Оболочка слайдера -->
    <div class="services__slider swiper mobile-slider-card">
      <!-- Двигающаяся часть слайдера -->
      <div class="services__wrapper swiper-wrapper">
        <!-- Слайд -->
        <div class="services__slide swiper-slide">
          <div class="services__card hover-lift">
            <h3 class="services__card-title">Дизайн</h3>
            <div class="services__card-body">
              <div class="services__card-images _ibg _ibg--color-overlay">
                <Image class="services__card-img _img" src={services01} alt="foto services" />
              </div>
              <div class="services__card-content">
                <p class="services__card-text">Для меня хороший дизайн — это гармония красоты и практичности. Я создаю визуальные решения, где современные тренды встречаются с удобством пользователя и вашими бизнес-целями. Каждый элемент — от цветового акцента до расстояния между кнопками — продуман так, чтобы ваш продукт выглядел профессионально и запоминался надолго.</p>
              </div>
              <div class="services__card-footer">
                <a class="button button--text" href="#">Подробнее</a>
              </div>
            </div>
          </div>
        </div>
        <!-- Слайд -->
        <div class="services__slide swiper-slide">
          <div class="services__card hover-lift">
            <h3 class="services__card-title">Верстка</h3>
            <div class="services__card-body">
              <div class="services__card-images _ibg _ibg--color-overlay">
                <Image class="services__card-img _img" src={services02} alt="foto services" />
              </div>
              <div class="services__card-content">
                <p class="services__card-text">В своей работе я превращаю статичные макеты в живые, "дышащие" страницы, которые безупречно работают на любом устройстве. Для меня важно, чтобы под капотом был не просто работающий код, а аккуратная верстка с молниеносной загрузкой и идеальным отображением во всех браузерах — это мой стандарт для каждого проекта.</p>
              </div>
              <div class="services__card-footer">
                <a class="button button--text" href="#">Подробнее</a>
              </div>
            </div>
          </div>
        </div>
        <!-- Слайд -->
        <div class="services__slide swiper-slide">
          <div class="services__card hover-lift">
            <h3 class="services__card-title">Интеграция CMS</h3>
            <div class="services__card-body">
              <div class="services__card-images _ibg _ibg--color-overlay">
                <Image class="services__card-img _img" src={services03} alt="foto services" />
              </div>
              <div class="services__card-content">
                <p class="services__card-text">Я помогаю вам получить полный контроль над сайтом без необходимости разбираться в коде. Подберу оптимальную систему управления — будь то популярный WordPress, удобный OpenCart или индивидуальное решение. После моей настройки вы сможете легко обновлять контент, менять структуру и управлять сайтом как настоящий профессионал.</p>
              </div>
              <div class="services__card-footer">
                <a class="button button--text" href="#">Подробнее</a>
              </div>
            </div>
          </div>
        </div>
        <!-- Слайд -->
        <div class="services__slide swiper-slide">
          <div class="services__card hover-lift">
            <h3 class="services__card-title">Публикация в сети</h3>
            <div class="services__card-body">
              <div class="services__card-images _ibg _ibg--color-overlay">
                <Image class="services__card-img _img" src={services04} alt="foto services" />
              </div>
              <div class="services__card-content">
                <p class="services__card-text">Когда я публикую сайт, это всегда больше, чем просто перенос файлов на сервер. Я тщательно настраиваю хостинг, регистрирую домен, оптимизирую DNS-записи и настраиваю безопасное HTTPS-соединение. Моя цель — сделать так, чтобы ваш сайт не просто появился в сети, а работал стабильно и защищенно с первой минуты.</p>
              </div>
              <div class="services__card-footer">
                <a class="button button--text" href="#">Подробнее</a>
              </div>
            </div>
          </div>
        </div>
        <!-- Слайд -->
        <div class="services__slide swiper-slide">
          <div class="services__card hover-lift">
            <h3 class="services__card-title">Контент менеджмент</h3>
            <div class="services__card-body">
              <div class="services__card-images _ibg _ibg--color-overlay">
                <Image class="services__card-img _img" src={services05} alt="foto services" />
              </div>
              <div class="services__card-content">
                <p class="services__card-text">Я убежден: контент должен работать на вас круглосуточно. Помогу организовать тексты, изображения и видео в понятную систему, где каждая публикация усиливает ваш бренд. Вместе мы превратим разрозненные материалы в мощный инструмент общения с клиентами.</p>
              </div>
              <div class="services__card-footer">
                <a class="button button--text" href="#">Подробнее</a>
              </div>
            </div>
          </div>
        </div>
        <!-- Слайд -->
        <div class="services__slide swiper-slide">
          <div class="services__card hover-lift">
            <h3 class="services__card-title">Поддержка</h3>
            <div class="services__card-body">
              <div class="services__card-images _ibg _ibg--color-overlay">
                <Image class="services__card-img _img" src={services06} alt="foto services" />
              </div>
              <div class="services__card-content">
                <p class="services__card-text">Я знаю, что сайт — как живой организм, ему нужно постоянное внимание. Возьму на себя технический мониторинг, оперативные исправления и регулярные обновления. С моей поддержкой ваш ресурс будет всегда актуальным, безопасным и работоспособным — вы сможете сосредоточиться на бизнесе.</p>
              </div>
              <div class="services__card-footer">
                <a class="button button--text" href="#">Подробнее</a>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Если нужна пагинация -->
      <div class="swiper-pagination" aria-label="Навигация по слайдам"></div>
      <!-- Если нужна навигация (влево/вправо) -->
      <!-- <button type="button" class="swiper-button-prev" aria-label="Предыдущий слайд"></button>
      <button type="button" class="swiper-button-next" aria-label="Следующий слайд"></button> -->
    </div>
  </div>

  <style lang="scss">
    // services.scss
    @use '@styles/base/mixins/grid.scss' as grid;
    @use '@styles/base/mixins/_truncate-text.scss' as *;

    .services {
      &__container {
      }

      &__slider {
      }

      &__wrapper {
        display: flex;
        padding: var(--space-md) 1px;
        //599px и более
        @media (min-width: $mobile-large) {
          @include grid.grid-2-columns(var(--space-grid-gap));
        }
        //1023px и более
        @media (min-width: $tablet-medium) {
          @include grid.grid-3-columns(var(--space-grid-gap));
        }
      }

      &__slide {
        max-width: 450px;
        //599px и более
        @media (min-width: $mobile-large) {
          max-width: 100%;
        }
      }

      &__card {
        //padding: var(--space-all-card);
        box-shadow: var(--box-shadow-Light-01);
        border-radius: var(--border-radius-medium);
        background: var(--md-sys-color-surface);
        min-width: 300px;
        width: 100%;
        //599px и более
        @media (min-width: $mobile-large) {
          background: inherit;
        }
      }

      &__card-title {
        padding: var(--space-md);
        font-size: var(--font-size-xxl);
        position: relative;
        &::before {
          content: '';
          position: absolute;
        }
      }

      &__card-body {
      }

      &__card-images {
      }

      &__card-img {
      }
      ._ibg {
        border-radius: 0;
        box-shadow: none;
      }

      &__card-content {
        padding-top: var(--space-md);
        padding-left: var(--space-md);
        padding-right: var(--space-md);
      }

      &__card-text {
        @include truncate-text(3);
      }

      &__card-footer {
        padding: var(--space-all-card);
      }
      .swiper {
      }
      .swiper-wrapper {
      }
      .swiper-slide {
      }
      .button {
      }
      .button--text {
      }
      .swiper-pagination {
      }
      .swiper-button-prev {
      }
      .swiper-button-next {
      }

      .swiper-scrollbar {
      }
    }
  </style>
</div>
