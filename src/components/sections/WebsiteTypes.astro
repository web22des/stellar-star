---
// текст для секции
// source/WebsiteTypes.txt
// src/components/sections/WebsiteTypes.astro

import { Image } from 'astro:assets';

import TitleSections from '../ui/TitleSection.astro';

const titleSection = 'Типы сайтов';
const subTitleSection = 'Подберу оптимальный вариант под ваши задачи';

import webTypes01 from '@assets/images/content/website-types/hero-01-pc.jpg';
import webTypes02 from '@assets/images/content/website-types/hero-02-pc.jpg';
import webTypes03 from '@assets/images/content/website-types/hero-03-pc.jpg';
import webTypes04 from '@assets/images/content/website-types/hero-04-pc.jpg';
import webTypes05 from '@assets/images/content/website-types/hero-05-pc.jpg';
import webTypes06 from '@assets/images/content/website-types/hero-06-pc.jpg';
---

<div class="website-types animate" id="website-types">
  <div class="website-types__container">
    <TitleSections titleSection={titleSection} subTitleSection={subTitleSection} />
    <div class="website-types__card">
      <div class="website-types__wrap-images _ibg _ibg--color-overlay">
        <Image class="website-types__images _img" src={webTypes01} alt="foto" />
      </div>
      <div class="website-types__content">
        <h3 class="website-types__title">Лендинг</h3>
        <div class="website-types__paragraph">
          <p class="website-types__text">Лендинг — это одностраничный сайт, который фокусируется на одном продукте, услуге или событии. Идеален для быстрого привлечения клиентов и увеличения конверсий.</p>
          <p class="website-types__text text-clear">Подходит для стартапов, маркетинговых акций, презентаций товаров или мероприятий. Например, лендинг используют для рекламы онлайн-курса, запуска новой коллекции бренда или сбора заявок на вебинар.</p>
        </div>
      </div>
    </div>
    <div class="website-types__card">
      <div class="website-types__wrap-images _ibg _ibg--color-overlay">
        <Image class="website-types__images _img" src={webTypes02} alt="foto" />
      </div>
      <div class="website-types__content">
        <h3 class="website-types__title">Тематический сайт</h3>
        <div class="website-types__paragraph">
          <p class="website-types__text">Тематический сайт посвящен конкретной нише: кулинария, путешествия, технологии и т.д. Это платформа для обмена знаниями и привлечения единомышленников.</p>
          <p class="website-types__text text-clear">Такой сайт подойдет экспертам, энтузиастам или сообществам. Например, сайт о здоровом питании для диетологов или ресурс с обзорами гаджетов для техноблогеров.</p>
        </div>
      </div>
    </div>
    <div class="website-types__card">
      <div class="website-types__wrap-images _ibg _ibg--color-overlay">
        <Image class="website-types__images _img" src={webTypes03} alt="foto" />
      </div>
      <div class="website-types__content">
        <h3 class="website-types__title">Сайт визитка</h3>
        <div class="website-types__paragraph">
          <p class="website-types__text">Сайт-визитка — это компактное онлайн-представительство. Он содержит ключевую информацию о человеке или небольшой компании: контакты, услуги, портфолио.</p>
          <p class="website-types__text text-clear">Идеален для фрилансеров, художников, юристов или небольших студий. Например, сайт фотографа с примерами работ и прайсом или страница консультанта с описанием услуг.</p>
        </div>
      </div>
    </div>
    <div class="website-types__card">
      <div class="website-types__wrap-images _ibg _ibg--color-overlay">
        <Image class="website-types__images _img" src={webTypes04} alt="foto" />
      </div>
      <div class="website-types__content">
        <h3 class="website-types__title">Корпоративный сайт</h3>
        <div class="website-types__paragraph">
          <p class="website-types__text">Корпоративный сайт отражает деятельность компании, ее ценности и услуги. Это инструмент для укрепления репутации и привлечения клиентов или партнеров.</p>
          <p class="website-types__text text-clear">Подходит среднему и крупному бизнесу: производственным фирмам, IT-компаниям, агентствам. Например, сайт строительной компании с кейсами или платформа для банка с описанием продуктов.</p>
        </div>
      </div>
    </div>
    <div class="website-types__card">
      <div class="website-types__wrap-images _ibg _ibg--color-overlay">
        <Image class="website-types__images _img" src={webTypes05} alt="foto" />
      </div>
      <div class="website-types__content">
        <h3 class="website-types__title">Интернет магазин</h3>
        <div class="website-types__paragraph">
          <p class="website-types__text">Интернет-магазин — это полноценная площадка для продажи товаров или услуг онлайн. Позволяет принимать заказы, обрабатывать платежи и управлять ассортиментом.</p>
          <p class="website-types__text text-clear">Необходим розничным магазинам, производителям или дистрибьюторам. Например, магазин одежды с каталогом и корзиной или площадка для продажи косметики ручной работы.</p>
        </div>
      </div>
    </div>
    <div class="website-types__card">
      <div class="website-types__wrap-images _ibg _ibg--color-overlay">
        <Image class="website-types__images _img" src={webTypes06} alt="foto" />
      </div>
      <div class="website-types__content">
        <h3 class="website-types__title">Блог</h3>
        <div class="website-types__paragraph">
          <p class="website-types__text">Блог — это динамичный сайт с регулярно обновляемым контентом: статьями, видео, обзорами. Помогает строить аудиторию и делиться экспертностью.</p>
          <p class="website-types__text text-clear">Подходит копирайтерам, путешественникам, педагогам или компаниям, продвигающим контент-маркетинг. Например, личный блог о родительстве или корпоративный блог IT-компании.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style lang="scss">
  @use '@styles/base/mixins/grid.scss' as grid;

  .website-types {
    padding-top: var(--space-xxl);

    &__container {
    }

    &__card {
      margin-bottom: 24px;
      // Исправленный селектор для четных карточек
      //767px и более
      @media (min-width: $tablet-small) {
        display: flex;
        gap: var(--space-grid-gap);
        &:nth-child(even) {
          flex-direction: row-reverse; // Добавлен reverse для изменения порядка
        }
      }
      //599px и более
      @media (min-width: $mobile-large) {
        display: flex;
        gap: var(--space-grid-gap);
        &:nth-child(even) {
          flex-direction: row-reverse; // Добавлен reverse для изменения порядка
        }
      }
    }

    &__wrap-images {
      margin-bottom: 24px;
      //599px и более
      @media (min-width: $mobile-large) {
        margin-bottom: 0;
      }
    }

    &__images {
      // width: 100%;
      // object-fit: cover;
    }

    &__content {
      //flex: 1;
      width: 100%;
      max-height: 260px;
      overflow-y: auto;
      //1279px и более
      @media (min-width: $tablet-large) {
        max-height: 100%;
      }
    }

    &__title {
      color: var(--md-sys-color-primary);
      font-size: var(--font-size-xxl);
      margin-bottom: var(--space-md);
      position: sticky;
    }

    &__paragraph {
      text-align: start;
    }

    &__text {
      color: var(--md-sys-color-secondary);
      text-shadow: 0px 1px 2px rgba(0, 0, 0, 0.05);
      margin-bottom: var(--space-md);
    }
  }
</style>
