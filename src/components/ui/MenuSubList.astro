---
import Link from './Link.astro';
---

<div class="menu" id="menu-nav">
  <!-- компонент кнопки бургер в другом места -->
  <nav class="menu__body" aria-label="Основное меню">
    <ul class="menu__list">
      <li class="menu__item">
        <button class="menu__link menu__btn-sublink" aria-expanded="false" aria-controls="home">Главная</button>
        <ul class="menu__sublist" aria-hidden="true" id="home">
          <li class="menu__subitem"><Link href="/" class="menu__sublink">На главную</Link></li>
          <li class="menu__subitem"><Link href="#advantages" class="menu__sublink">Преимущества</Link></li>
          <li class="menu__subitem"><Link href="#services" class="menu__sublink">Услуги</Link></li>
          <li class="menu__subitem"><Link href="#website-types" class="menu__sublink">Виды сайтов</Link></li>
          <li class="menu__subitem"><Link href="#development-process" class="menu__sublink">Процесс разработки</Link></li>
          <li class="menu__subitem"><Link href="#result" class="menu__sublink">Результат</Link></li>
          <li class="menu__subitem"><Link href="#examples-work" class="menu__sublink">Галерея</Link></li>
          <li class="menu__subitem"><Link href="#contact-form" class="menu__sublink">Обратная связь</Link></li>
        </ul>
      </li>
      <li class="menu__item"><Link href="/gallery/" class="menu__link">Галерея</Link></li>
      <li class="menu__item">
        <button class="menu__link menu__btn-sublink" aria-expanded="false" aria-controls="submenu-1">Новости</button>
        <ul class="menu__sublist" aria-hidden="true" id="submenu-1">
          <li class="menu__subitem"><Link href="/news/" class="menu__sublink">Новости IT</Link></li>
          <li class="menu__subitem"><Link href="/post/" class="menu__sublink">Блог</Link></li>
          <li class="menu__subitem"><Link href="/documentation/" class="menu__sublink">Документация</Link></li>
        </ul>
      </li>
      <li class="menu__item"><Link href="/contacts/" class="menu__link">Контакты</Link></li>
    </ul>
  </nav>
</div>
<!-- Преимущества Услуги Виды сайтов Процесс разработки Результат Галерея Обратная связь -->
<style lang="scss">
  .menu {
    padding-top: var(--space-section);
    padding-left: var(--space-all-card);
    height: 100vh;
    max-width: 320px;
    //background: var(--md-sys-color-surface-bright);
    //767px и более
    @media (min-width: $tablet-medium) {
      padding-top: 0;
      padding-left: 0;
      height: auto;
      max-width: 100%;
    }
    &__body {
    }

    &__list {
      background: inherit;
      //border: 2px solid #a30909;
      //767px и более
      @media (min-width: $tablet-medium) {
        display: flex;
        gap: 52px;
        justify-content: center;
        align-items: center;
      }
    }

    &__item {
      position: relative;
      margin-bottom: 24px;
      //767px и более
      @media (min-width: $tablet-medium) {
        position: relative;
        margin-bottom: 0;
      }
    }

    &__link {
      //position: relative;
    }

    &__btn-sublink {
      display: inline-flex;
      align-items: center;
      &::after {
        font-family: 'icomoon';
        font-size: 12px;
        content: '\ea43';
        margin-left: 8px;
        color: inherit;
        display: inline-block; // Необходимо для transform
        transform: rotate(180deg);
        transition: transform 0.5s ease; // Плавная анимация
      }
      &[aria-expanded='true']::after {
        transform: rotate(0); // Поворачиваем при открытом состоянии
      }
    }

    &__sublist {
      // Начальное состояние (скрыто)
      margin-bottom: var(--space-md);

      position: absolute;
      top: 24px; // Выпадает прямо под кнопкой
      //left: 12px;
      margin-left: 0;

      padding-top: var(--space-all-card);
      padding-bottom: var(--space-all-card);
      width: max-content;
      box-shadow: var(--box-shadow-Light-02);
      background: inherit;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-20px); // Начинаем чуть выше
      margin-left: 20px;
      transition: all var(--transition-duration-slow);
      pointer-events: none; // Блокируем клики в скрытом состоянии
      background: var(--md-sys-color-surface-bright);
      // Открытое состояние
      &[aria-hidden='false'] {
        opacity: 1;

        visibility: visible;
        transform: translateY(0);
        pointer-events: auto; // Разрешаем клики
        scroll-behavior: smooth;

        z-index: 10;
      }

      //767px и более Для десктопов
      @media (min-width: $tablet-medium) {
        //position: absolute;

        //min-width: 200px; // Чтобы не сжималось
      }
    }

    &__link,
    &__sublink {
      font-size: 18px;
      text-transform: uppercase;

      //767px и более
      @media (min-width: $tablet-medium) {
        text-transform: capitalize;
      }
    }

    &__sublink {
      color: tomato;
      display: block;
      padding: 4px 16px;
      html.no-touch & {
        &:hover {
          background: var(--md-sys-color-surface-container);
        }
      }
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const menuButtons = document.querySelectorAll('.menu__btn-sublink');

    // Функция для закрытия всех меню
    function closeAllMenus() {
      menuButtons.forEach((button) => {
        const submenu = document.getElementById(button.getAttribute('aria-controls'));
        button.setAttribute('aria-expanded', 'false');
        submenu.setAttribute('aria-hidden', 'true');
        submenu.classList.remove('menu__sublist-open');
      });
    }

    // Инициализация - закрываем все меню
    closeAllMenus();

    // Обработчик клика по кнопкам меню
    menuButtons.forEach((button) => {
      button.addEventListener('click', (e) => {
        e.stopPropagation();
        const submenu = document.getElementById(button.getAttribute('aria-controls'));
        const isExpanded = button.getAttribute('aria-expanded') === 'true';

        // Закрываем все меню перед открытием текущего
        if (!isExpanded) closeAllMenus();

        // Переключаем текущее меню
        button.setAttribute('aria-expanded', String(!isExpanded));
        submenu.setAttribute('aria-hidden', String(isExpanded));
        //submenu.classList.toggle('menu__sublist-open', !isExpanded);
      });
    });

    // Закрытие при клике вне меню
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.menu__btn-sublink') && !e.target.closest('.menu__sublist')) {
        closeAllMenus();
      }
    });

    // Закрытие при нажатии Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAllMenus();
    });
  });
</script>
